# ===== 不纳入版本库的内容 =====

# 原始实测样本媒体（209MB 输入素材，非工作台源码）
# 如需随仓库分发，建议改用 Git LFS 或外链，不要直接进 Git
短剧实测/

# 构建临时物
**/_build/
node_modules/

# 日志与本地运行数据（含本机绝对路径，非源码）
*.log
data/ops.log

# ===== 生成素材与产出文件（二进制，不入代码仓库）=====
# 仅保留源代码(prototype/scripts)与实例过程文档(md/json/jsonl)
# 以下二进制媒体一律排除：图片/音频/视频/合成产物
# 说明：03_asset/04_output/05_review 等目录内的 json/md 过程文档(清单/质检报告)
#       属于实例相关文件，予以保留；仅排除其中的二进制媒体。
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.bmp
*.tif
*.tiff
*.mp4
*.mov
*.webm
*.mkv
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg

# TTS 引擎能力探测的音频产物（data/tts_probe/*.mp3，纯测试音频，不入仓）
# 注意：该目录下的 probe-result.json（文本）仍保留
data/tts_probe/*.mp3

# 代理/IDE 内部数据（WorkBuddy 项目记忆，非源码）
.workbuddy/

# 本地冒烟测试遗留的 headless Edge 浏览器 profile（含 cookie/缓存，隐私+体积）
data/_edge_smoke_hr/

# 浏览器本地存储导出（测试产物）
data/localStorage-backup-*.json

# OS / 编辑器 / IDE 临时
.DS_Store
Thumbs.db
.idea/
.vscode/
